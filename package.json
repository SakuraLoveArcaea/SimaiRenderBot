{
  "name": "simai-render-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot: simai 片段 → 譜面預覽 GIF",
  "scripts": {
    "render": "node src/cli.js",
    "bot": "node src/bot.js",
    "register": "node src/register-commands.js",
    "build:activity": "esbuild activity/main.js --bundle --format=esm --outfile=activity/public/dist/main.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.8.1",
    "discord.js": "^14.27.0",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
