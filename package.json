{
  "name": "simai-render-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot: simai 片段 → 譜面預覽 GIF",
  "scripts": {
    "render": "node src/cli.js",
    "bot": "node src/bot.js",
    "register": "node src/register-commands.js",
    "dev:activity": "vite dev --config activity/app/vite.config.js",
    "server:activity": "node src/activity-server.js",
    "build:activity": "vite build --config activity/app/vite.config.js",
    "test:activity": "node activity/app/smoke-test.mjs",
    "test:activity:webkit": "BROWSER_ENGINE=webkit node activity/app/smoke-test.mjs",
    "upload:charts": "node scripts/upload-charts.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.8.1",
    "discord.js": "^14.27.0",
    "firebase": "^12.17.1",
    "playwright-core": "^1.49.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.1.5"
  }
}
