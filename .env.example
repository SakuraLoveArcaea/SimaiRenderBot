# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
DISCORD_APP_ID=

# （選填）指定伺服器 ID：填了指令會即時註冊到這些伺服器；可用逗號分隔多個，例如 111,222；不填則全域註冊（生效較慢）
DISCORD_GUILD_ID=

# （選填）單次最長渲染的譜面秒數，超過的部分不畫，預設 30
MAX_DURATION=30

# （選填）預估渲染耗時上限（秒），超過就拒絕渲染，預設 30
MAX_RENDER_SEC=30

# （選填）每位使用者冷卻毫秒數，預設 10000
COOLDOWN_MS=10000

# （選填）設 1 才註冊隱藏的 /keyboard 互動鍵盤指令
ENABLE_KEYBOARD=0

# 【測試用】/activity 互動頁面（Discord Activity）：設 1 才註冊指令、啟動後端伺服器
ENABLE_ACTIVITY=0

# 【測試用】Activity 用的 OAuth2 Client Secret：Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=

# 【測試用】Activity 後端伺服器監聽的 port，預設 3000（要用 cloudflared 之類的 tunnel 對外開）
ACTIVITY_PORT=3000

# 【測試用】Activity 的 Redirect URI，必須跟 Developer Portal -> OAuth2 -> Redirects 裡填的一模一樣，預設 https://127.0.0.1
# DISCORD_REDIRECT_URI=https://127.0.0.1

